        <mxCell id="e34" edge="1" parent="1" source="s3" style="endArrow=block;html=1;rounded=0;strokeWidth=2;strokeColor=#64748b;" target="s4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e45" edge="1" parent="1" source="s4" style="endArrow=block;html=1;rounded=0;strokeWidth=2;strokeColor=#64748b;" target="s5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="note_parallel" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fillColor=#ffffff;strokeColor=#cbd5e1;strokeWidth=1;arcSize=10;" value="Parallel paths are intentional:&#xa;Different abstractions produce different truths.&#xa;&#xa;&lt;span style=&quot;color:#075985;font-weight:700;&quot;&gt;S1&lt;/span&gt;: different observation pipelines&#xa;&lt;span style=&quot;color:#14532d;font-weight:700;&quot;&gt;S2&lt;/span&gt;: different feature abstractions&#xa;&lt;span style=&quot;color:#7c2d12;font-weight:700;&quot;&gt;S3&lt;/span&gt;: different structure models">
          <mxGeometry height="120" width="296" x="64" y="412" as="geometry" />
        </mxCell>
        <mxCell id="rules" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#ffffff;strokeColor=#cbd5e1;strokeWidth=1;movable=1;resizable=1;rotatable=1;deletable=1;editable=1;locked=0;connectable=1;" value="Core rules&#xa;1. No step is neutral&#xa;2. Every transformation loses information&#xa;3. Multiple representations are necessary&#xa;4. &lt;span style=&quot;color:#7c2d12;font-weight:700;&quot;&gt;Structure&lt;/span&gt; is modelled, not discovered&#xa;5. &lt;span style=&quot;color:#881337;font-weight:700;&quot;&gt;Decisions&lt;/span&gt; are justified, not computed&#xa;6. Reproducibility is mandatory&#xa;7. Interpretation belongs outside the code">
          <mxGeometry height="140" width="246" x="65" y="276" as="geometry" />
        </mxCell>
        <mxCell id="fail" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#ffffff;strokeColor=#cbd5e1;strokeWidth=1;" value="Typical failure modes&#xa;• tools ≠ models&#xa;• &lt;span style=&quot;color:#14532d;font-weight:700;&quot;&gt;features&lt;/span&gt; treated as reality&#xa;• assumptions hidden in code&#xa;• &lt;span style=&quot;color:#881337;font-weight:700;&quot;&gt;optimisation&lt;/span&gt; before understanding &lt;span style=&quot;color:#7c2d12;font-weight:700;&quot;&gt;structure&lt;/span&gt;&#xa;• overfitting spatial detail&#xa;• ignoring scale effects">
          <mxGeometry height="140" width="306" x="64" y="536" as="geometry" />
        </mxCell>
        <mxCell id="succ" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontStyle=1;fillColor=#ffffff;strokeColor=#cbd5e1;strokeWidth=1;" value="Success criterion&#xa;You can explain:&#xa;• why a result looks as it does&#xa;• which assumptions created it (S0–S4)&#xa;• how it changes under different abstractions in &lt;span style=&quot;color:#075985;font-weight:700;&quot;&gt;S1&lt;/span&gt;, &lt;span style=&quot;color:#14532d;font-weight:700;&quot;&gt;S2&lt;/span&gt;, &lt;span style=&quot;color:#7c2d12;font-weight:700;&quot;&gt;S3&lt;/span&gt;, &lt;span style=&quot;color:#881337;font-weight:700;&quot;&gt;S4&lt;/span&gt;">
          <mxGeometry height="120" width="1040" x="64" y="697" as="geometry" />
        </mxCell>
      </root>
