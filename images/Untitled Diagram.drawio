        <mxCell id="note_parallel" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontStyle=1;" value="Parallel paths are intentional:&#xa;Different abstractions produce different truths." vertex="1">
          <mxGeometry height="70" width="480" x="64" y="630" as="geometry" />
        </mxCell>
        <mxCell id="rules" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" value="Core rules&#xa;1. No step is neutral&#xa;2. Every transformation loses information&#xa;3. Multiple representations are necessary&#xa;4. Structure is modelled, not discovered&#xa;5. Decisions are justified, not computed&#xa;6. Reproducibility is mandatory&#xa;7. Interpretation belongs outside the code" vertex="1">
          <mxGeometry height="170" width="530" x="574" y="630" as="geometry" />
        </mxCell>
        <mxCell id="fail" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" value="Typical failure modes&#xa;• tools ≠ models&#xa;• features treated as reality&#xa;• assumptions hidden in code&#xa;• optimisation before structure understanding&#xa;• overfitting spatial detail&#xa;• ignoring scale effects" vertex="1">
          <mxGeometry height="120" width="480" x="64" y="720" as="geometry" />
        </mxCell>
        <mxCell id="succ" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontStyle=1;" value="Success criterion&#xa;You can explain:&#xa;• why a result looks as it does&#xa;• which assumptions created it&#xa;• how it changes under different abstractions" vertex="1">
