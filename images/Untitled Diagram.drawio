        <mxCell id="t1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontStyle=1;fontSize=18;" value="Spatial Research Pipeline — Didactic Core Model" vertex="1">
          <mxGeometry height="50" width="1040" x="60" y="30" as="geometry" />
        </mxCell>
        <mxCell id="t2" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=12;" value="Goal: conceptual modelling and epistemic reasoning (not programming). Every step transforms reality and introduces assumptions." vertex="1">
          <mxGeometry height="40" width="1040" x="60" y="90" as="geometry" />
        </mxCell>
        <mxCell id="s0" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontStyle=1;fillColor=#f3e8ff;strokeColor=#7c3aed;fontColor=#5b21b6;strokeWidth=2;" value="S0 — Problem Space&#xa;Question • scale • decision targets" vertex="1">
          <mxGeometry height="80" width="300" x="60" y="170" as="geometry" />
        </mxCell>
        <mxCell id="s1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontStyle=1;fillColor=#e0f2fe;strokeColor=#0284c7;fontColor=#075985;strokeWidth=2;" value="S1 — Observation Space&#xa;Data sources • AOI • uncertainty enters" vertex="1">
          <mxGeometry height="80" width="300" x="410" y="170" as="geometry" />
        </mxCell>
        <mxCell id="s2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontStyle=1;fillColor=#dcfce7;strokeColor=#16a34a;fontColor=#14532d;strokeWidth=2;" value="S2 — Feature Space&#xa;Process proxies • indicators • scale/aggregation" vertex="1">
          <mxGeometry height="80" width="340" x="760" y="170" as="geometry" />
        </mxCell>
        <mxCell id="s3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontStyle=1;fillColor=#ffedd5;strokeColor=#f97316;fontColor=#7c2d12;strokeWidth=2;" value="S3 — Structural Space&#xa;Segmentation • strata • spatial units" vertex="1">
          <mxGeometry height="80" width="340" x="760" y="310" as="geometry" />
        </mxCell>
        <mxCell id="s4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontStyle=1;fillColor=#ffe4e6;strokeColor=#e11d48;fontColor=#881337;strokeWidth=2;" value="S4 — Decision Space&#xa;Objectives • trade-offs • selection/optimisation" vertex="1">
          <mxGeometry height="80" width="340" x="760" y="460" as="geometry" />
        </mxCell>
        <mxCell id="s5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontStyle=1;fillColor=#e2e8f0;strokeColor=#334155;fontColor=#0f172a;strokeWidth=2;" value="S5 — Validation Space&#xa;Stability • sensitivity • robustness/transfer" vertex="1">
          <mxGeometry height="80" width="340" x="760" y="590" as="geometry" />
        </mxCell>
        <mxCell id="e01" edge="1" parent="1" source="s0" style="endArrow=block;html=1;rounded=0;strokeWidth=2;strokeColor=#64748b;" target="s1">
          <mxGeometry relative="1" as="geometry" />
